<?xml version="1.0"?>
<!--
  robomo.club robot - URDF published by the frankjoshua/ros2-urdf image (robot_state_publisher).

  The VISUAL + TF model the real-robot software stack uses (slam_toolbox, nav2). Every joint is
  fixed and every visual is a primitive, so the image is self-contained: robot_state_publisher
  renders a recognizable robot in Foxglove/RViz with no mesh server (rosbridge can't fetch
  package:// or http meshes anyway). The high-fidelity Blender mesh and its HTTP mesh server live
  in the robomo-club-robot repo (model/, docker-compose-model.yml) for nicer dev visualization.

  Frames match the live stack and robomo-club-robot/model/robomo.urdf:
    base_link              : root; diff_drive_controller publishes odom->base_link
    base_footprint         : ground projection
    laser_frame            : /scan, YDLidar X4 on top of the pole (~1.23 m)
    camera_link / _optical : Realsense on the front of the base
    imu_link / gps_link    : pole electronics shelf
-->
<robot name="robomo">

  <material name="body">   <color rgba="0.20 0.40 0.70 1.0"/></material>
  <material name="dark">   <color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="sensor"> <color rgba="0.90 0.60 0.10 1.0"/></material>

  <!-- Base body and the vertical pole that carries the lidar, as primitives on base_link.
       base_link sits at ground level (base_footprint is coincident), matching model/robomo.urdf. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.42 0.31 0.20"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <origin xyz="0.03 0 0.71" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="1.02"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/><child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels (cosmetic; diff_drive_controller owns odom->base_link, not wheel TF) -->
  <link name="drivewhl_l_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="drivewhl_l_joint" type="fixed">
    <parent link="base_link"/><child link="drivewhl_l_link"/>
    <origin xyz="-0.12 0.18 0.10" rpy="0 0 0"/>
  </joint>

  <link name="drivewhl_r_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="drivewhl_r_joint" type="fixed">
    <parent link="base_link"/><child link="drivewhl_r_link"/>
    <origin xyz="-0.12 -0.18 0.10" rpy="0 0 0"/>
  </joint>

  <!-- YDLidar X4 on top of the pole: /scan frame -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/>
    <origin xyz="0.03 0 1.23" rpy="0 0 0"/>
  </joint>

  <!-- Intel Realsense on the front of the base, facing forward -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.31 0 0.28" rpy="0 0 0"/>
  </joint>
  <!-- optical frame (REP-103: z forward, x right, y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- IMU on the pole electronics shelf -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.05 0.08 0.594" rpy="0 0 0"/>
  </joint>

  <!-- GPS on the pole electronics shelf -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="0.07 -0.02 0.60" rpy="0 0 0"/>
  </joint>

</robot>
